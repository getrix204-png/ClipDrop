# ── Obligatorio ──
NODE_ENV=production
# Orígenes (tu PWA en Vercel) autorizados por CORS: https, sin barra final, separados por comas
ALLOWED_ORIGINS=https://clipdrop-psi.vercel.app
# Opcional: regex para las previews de tu proyecto en Vercel
# ALLOWED_ORIGIN_REGEX=^https://clipdrop-[a-z0-9-]+-TU-EQUIPO\.vercel\.app$

# ── Recomendado ──
# URL pública del backend (si falta se deduce de la petición)
# PUBLIC_URL=https://clipdrop-api.onrender.com
# Saltos de proxy delante del servidor (1 en Render/Railway/Fly; 2 si añades Cloudflare)
TRUST_PROXY=1

# ── Límites (valores por defecto) ──
# MAX_FILE_MB=1024
# MAX_DURATION_MIN=180
# MAX_PARALLEL=3          # extracciones simultáneas
# MAX_PREPARE=2           # fusiones/conversiones simultáneas
# MAX_STREAMS=40
# RATE_EXTRACT_PER_MIN=15
# RATE_FILE_PER_MIN=60

# ── Opcional ──
# YTDLP_COOKIES=/etc/secrets/cookies.txt   # cookies.txt de TU cuenta (contenido que ya puedes ver)
